# Environment configuration for TraceMesh

NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tracemesh
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracemesh?schema=public"

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Backend API
PORT=3001
API_URL="http://localhost:3001"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# Optional OSINT API Keys (Enables high-quota live intelligence lookups)
# If left unset, TraceMesh automatically falls back to free passive/DoH live resolvers.
# -----------------------------------------------------------------------------
GITHUB_TOKEN=""
SHODAN_API_KEY=""
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
INTELX_API_KEY=""
HUNTER_API_KEY=""
IPINFO_TOKEN=""
CENSYS_API_ID=""
CENSYS_API_SECRET=""
