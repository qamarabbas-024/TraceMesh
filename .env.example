# Environment configuration for TraceMesh

NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tracemesh
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracemesh?schema=public"

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Backend API
PORT=3001
API_URL="http://localhost:3001"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
