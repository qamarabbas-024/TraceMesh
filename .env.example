# TraceMesh Environment Configuration Template
# All keys should be populated in your local .env file (which is gitignored)

PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracemesh?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-with-secure-random-secret-key-in-production"

# Optional OSINT API Integrations (Free tiers / Passive lookups used by default)
OTX_API_KEY=
IPINFO_TOKEN=
ABUSEIPDB_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SHODAN_API_KEY=
GITHUB_API_TOKEN=
