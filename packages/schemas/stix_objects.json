{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TraceMeshSTIXObjectBundle",
  "type": "object",
  "properties": {
    "type": { "type": "string", "enum": ["bundle"] },
    "id": { "type": "string" },
    "spec_version": { "type": "string", "enum": ["2.1"] },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "created", "modified"],
        "properties": {
          "type": { "type": "string" },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "confidence": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  },
  "required": ["type", "id", "spec_version", "objects"]
}
